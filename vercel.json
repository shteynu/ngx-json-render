{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "true",
  "buildCommand": "mkdir -p .vercel-static && touch .vercel-static/.keep",
  "outputDirectory": ".vercel-static",
  "redirects": [
    {
      "source": "/:path*",
      "destination": "https://ngx-json-render.angular-generative-ui-chat.workers.dev/:path*",
      "statusCode": 308
    }
  ]
}
