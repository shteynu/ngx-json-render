{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "ngx-json-render": {
      "projectType": "library",
      "root": "projects/ngx-json-render",
      "sourceRoot": "projects/ngx-json-render/src",
      "prefix": "jr",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-json-render/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-json-render/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-json-render/tsconfig.spec.json",
            "coverageInclude": [
              "projects/ngx-json-render/src/**",
              "projects/ngx-json-render/testing/src/**",
              "projects/ngx-json-render/mcp/src/**",
              "projects/ngx-json-render/devtools/src/**",
              "projects/ngx-json-render/router/src/**",
              "projects/ngx-json-render/ag-ui/src/**"
            ],
            "coverageThresholds": {
              "statements": 94,
              "branches": 88,
              "functions": 92,
              "lines": 96
            },
            "include": [
              "**/*.spec.ts",
              "../testing/src/**/*.spec.ts",
              "../mcp/src/**/*.spec.ts",
              "../devtools/src/**/*.spec.ts",
              "../router/src/**/*.spec.ts",
              "../ag-ui/src/**/*.spec.ts"
            ]
          }
        }
      }
    },
    "demo": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/demo",
      "sourceRoot": "projects/demo/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/demo/src/main.ts",
            "tsConfig": "projects/demo/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/demo/public"
              }
            ],
            "styles": [
              "projects/demo/src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "demo:build:production"
            },
            "development": {
              "buildTarget": "demo:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": [
              "projects/demo/src/**"
            ],
            "coverageThresholds": {
              "statements": 89,
              "branches": 87,
              "functions": 75,
              "lines": 92
            },
            "coverageExclude": [
              "projects/demo/src/index.html"
            ]
          }
        }
      }
    },
    "ngx-json-render-material": {
      "projectType": "library",
      "root": "projects/ngx-json-render-material",
      "sourceRoot": "projects/ngx-json-render-material/src",
      "prefix": "jrm",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-json-render-material/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-json-render-material/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "projects/ngx-json-render-material/tsconfig.spec.json",
            "coverageInclude": [
              "projects/ngx-json-render-material/src/**"
            ],
            "coverageThresholds": {
              "statements": 97,
              "branches": 95,
              "functions": 91,
              "lines": 98
            }
          }
        }
      }
    },
    "mcp-app": {
      "projectType": "application",
      "schematics": {},
      "root": "projects/mcp-app",
      "sourceRoot": "projects/mcp-app/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/mcp-app/src/main.ts",
            "tsConfig": "projects/mcp-app/tsconfig.app.json",
            "styles": [
              "projects/mcp-app/src/styles.scss"
            ],
            "outputPath": "dist/mcp-app/angular",
            "outputHashing": "none"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.5MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "coverageInclude": [
              "projects/mcp-app/src/**"
            ],
            "coverageExclude": [
              "projects/mcp-app/src/index.html",
              "projects/mcp-app/src/main.ts"
            ],
            "coverageThresholds": {
              "statements": 95,
              "branches": 90,
              "functions": 90,
              "lines": 95
            }
          }
        }
      }
    }
  }
}
