{
  "name": "ngx-json-render",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && ng serve demo",
    "build": "ng build ngx-json-render && ng build ngx-json-render-material && ng build demo",
    "build:lib": "ng build ngx-json-render",
    "watch:lib": "ng build ngx-json-render --watch --configuration development",
    "test": "ng test ngx-json-render --coverage && ng test demo --coverage && npm run test:material",
    "build:material": "ng build ngx-json-render-material",
    "test:material": "node scripts/run-material-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:peers": "node scripts/check-peer-ranges.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@json-render/core": "^0.20.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
