{
  "name": "ngx-json-render",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:lib && npm run build:material && ng serve demo",
    "build": "npm run build:lib && npm run build:material && ng build demo",
    "build:lib": "ng build ngx-json-render && node scripts/build-schematics.mjs ngx-json-render",
    "watch:lib": "ng build ngx-json-render --watch --configuration development",
    "test": "npm run build:lib && npm run build:material && ng test ngx-json-render --coverage && ng test demo --coverage && ng test mcp-app --coverage && npm run test:material && npm run test:schematics",
    "build:material": "ng build ngx-json-render-material && node scripts/build-schematics.mjs ngx-json-render-material",
    "test:material": "node scripts/run-material-tests.mjs",
    "test:schematics": "node --test \"projects/*/schematics/**/*.test.mjs\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:scripts": "node --test scripts/lib/*.test.mjs",
    "check:peers": "node scripts/check-peer-ranges.mjs",
    "check:zoneless": "node scripts/check-zoneless.mjs",
    "check:published": "node scripts/check-published-resolution.mjs",
    "check:skills": "node scripts/check-skill-snippets.mjs",
    "sync:plugin": "node scripts/sync-plugin.mjs",
    "check:plugin": "node scripts/sync-plugin.mjs --check",
    "capture:gif": "node scripts/capture-streaming-gif.mjs",
    "build:mcp-app": "node scripts/build-mcp-app.mjs",
    "pack:chatgpt-plugin": "node scripts/pack-chatgpt-plugin.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@json-render/core": "^0.21.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.22",
    "@angular/cli": "^21.2.22",
    "@angular/compiler-cli": "^21.2.0",
    "@json-render/devtools": "^0.21.0",
    "@json-render/directives": "^0.21.0",
    "@json-render/mcp": "^0.21.0",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^4.1.11",
    "ai": "^7.0.87",
    "esbuild": "^0.28.1",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
